# --- secrets ---------------------------------------------------------------
# Real credentials live here. .env.example carries the placeholders instead.
.env

# --- python ----------------------------------------------------------------
.venv/
__pycache__/
*.pyc

# --- node ------------------------------------------------------------------
landing/node_modules/
node_modules/

# --- build output ----------------------------------------------------------
# Regenerated by `python run.py` (or `npm run build`) on a fresh clone.
landing/dist/

# --- generated data --------------------------------------------------------
# stats.json IS committed: the deployed landing page and the Streamlit Cloud
# globe both read it, and neither has a database to regenerate it from at build
# time. Refresh with `python scripts/export_stats.py` and commit the result.

# --- scratch ---------------------------------------------------------------
.DS_Store
*.log
landing/public/assets/source/*.pdf
.vercel/

# deployment secrets - never commit
deploy/streamlit-secrets.toml
.streamlit/secrets.toml
